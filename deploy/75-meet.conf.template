# Websitemeting — meet.globaal.be (sales-dashboard, spec §15)
#
# Publiek, zonder Authentik: de eigen websites laden hier het meetscript en sturen
# hun metingen naartoe. Er staan precies twee paden open, allebei naar app-sales:
#   GET  /m.js       het meetscript
#   POST /api/meet   de inname
# Al de rest geeft 404, zodat het dashboard via dit adres onbereikbaar blijft.
# Bron van deze template: sales-dashboard/deploy/75-meet.conf.template.
server {
    listen 443 ssl;
    http2 on;
    server_name meet.${BASE_DOMAIN};
    include /etc/nginx/snippets/ssl.conf;
    server_tokens off;

    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Docker-DNS + variabele: een herbouw van app-sales vraagt geen nginx-herlading,
    # en ontbreekt de container even, dan faalt alleen dit adres (niet heel nginx).
    resolver 127.0.0.11 valid=30s;
    set $app_upstream http://app-sales:3008;

    client_max_body_size 64k;

    location = /m.js {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=3600" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        proxy_pass $app_upstream;
    }

    location = /api/meet {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Het bronadres komt van nginx zelf, nooit van wat de bezoeker meestuurt.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-authentik-username "";
        proxy_set_header X-authentik-groups   "";
        proxy_set_header X-authentik-email    "";
        proxy_set_header X-authentik-name     "";
        proxy_set_header X-authentik-uid      "";
        access_log off;
        proxy_pass $app_upstream;
    }

    location / {
        return 404;
    }
}
