# Kopieer naar .env.local (lokaal) of zet deze waarden in ~/appportal/.env (op de VM).
# Nooit committen — .env* staat in .gitignore.

# Pipedrive API-tokens per account (Pipedrive > Instellingen > Persoonlijk > API).
PIPEDRIVE_TOKEN_HARCHITECTS=
PIPEDRIVE_TOKEN_UNABO=
PIPEDRIVE_TOKEN_TKNBURO=
PIPEDRIVE_TOKEN_ENERGIEEFFICIENT=

# Anthropic API-key voor het analyse-panel (console.anthropic.com).
ANTHROPIC_API_KEY=

# Google Ads (SEO/SEA-tab). Zonder deze vier doet de advertentie-sync niets.
# Let op: Google trekt API-versies na ~1 jaar in; GOOGLE_ADS_API_VERSION
# overschrijft de standaard in lib/googleAds.ts als dat weer gebeurt.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=

# Token voor de agent-API (/api/v1, zie docs/AGENT-API.md). Leeg = API uit.
SALES_AGENT_TOKEN=
